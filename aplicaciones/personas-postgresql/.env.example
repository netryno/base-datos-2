# Puerto de la API en el host (MySQL 8073, MSSQL 8074, PostgreSQL 8075)
API_HOST_PORT=8075

# Red Docker donde corre my-database (postgres:18.1 del otro compose)
DOCKER_POSTGRES_NETWORK=bd-postgresql-docker_default

# Conexión a PostgreSQL — contenedor my-database en esa red (DB_PORT siempre 5432 ahí)
DB_HOST=my-database
DB_PORT=5432
DB_USER=alumno
DB_PASSWORD=123456
DB_NAME=course-db
