# Puerto en el host (y dentro del contenedor). La aplicación se abre en http://localhost:8078
APP_PORT=8078

# MongoDB (contenedor "mongo" de la red bd-mongo_default).
MONGO_URI=mongodb://admin:123456@mongo:27017/?authSource=admin
DB_NAME=bd-kahoot

# Redis (contenedor "redis" de la red bd-redis-docker_default).
REDIS_URL=redis://:123456@redis:6379/0

# Redes Docker externas donde ya corren Mongo y Redis (ver: docker network ls).
DOCKER_MONGO_NETWORK=bd-mongo_default
DOCKER_REDIS_NETWORK=bd-redis-docker_default

# --- Partida ---
# Segundos por pregunta
QUESTION_DURATION=25
# Tamaño del ranking (top 10)
TOP_N=10
# Puntos por respuesta correcta
BASE_POINTS=10
# Bonus por velocidad: hasta SPEED_BONUS_MAX * restante / duración
SPEED_BONUS_ENABLED=true
SPEED_BONUS_MAX=5
# first: una vez que el jugador confirma ("Sí") ya no puede cambiar; last: puede cambiar hasta el deadline
ANSWER_POLICY=first
# Fichero con categorías y preguntas que se precargan al arrancar (solo las que falten)
SEED_FILE=preguntas.json
# 0 = el Profesor pulsa "Siguiente"; >0 = avanza solo tras N segundos de ranking
AUTO_ADVANCE_SECONDS=0
# Segundos extra que vive game:{id}:state en Redis tras la duración máxima de la partida
GAME_STATE_TTL=3600

# --- Lock del Profesor / Publicador ---
# SET publisher:lock <json> NX EX 15
PUBLISHER_LOCK_TTL=15
# El navegador renueva el lock cada 5 s
HEARTBEAT_INTERVAL=5

# --- Jugadores ---
MIN_NAME_LENGTH=2
MAX_NAME_LENGTH=20
